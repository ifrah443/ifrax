<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | Management System
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .alert {
      padding: 12px;
      margin: 16px 0;
      border-radius: 4px;
    }

    .alert-error {
      background: #fee;
      color: #900;
      border: 1px solid #fcc;
    }

    .alert-success {
      background: #efe;
      color: #090;
      border: 1px solid #cfc;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group small {
      display: block;
      color: #666;
      margin-top: 4px;
    }

    [disabled] {
      background: #f5f5f5;
      cursor: not-allowed;
    }
  </style>
</head>

<body>
  <main class="container">
    <div class="form-card">
      <a href="/login" class="back-link">← Back to Login</a>
      <h1>
        <%= title %>
      </h1>
      <p>Create a new employee account to manage the system.</p>

      <% if (error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
        <% } %>
          <% if (success) { %>
            <div class="alert alert-success">
              <%= success %>
            </div>
            <% } %>

              <form action="/auth/register" method="POST">
                <!-- Username for login -->
                <div class="form-group">
                  <label for="username">Username <small>(for login)</small></label>
                  <input type="text" id="username" name="username" required placeholder="e.g., jdoe, askari_ali"
                    pattern="[a-zA-Z0-9_]{3,50}" title="3-50 characters: letters, numbers, underscores only"
                    value="<%= formData?.username || '' %>">
                  <small>Used to sign in. Letters, numbers, and underscores only.</small>
                </div>

                <!-- Optional: Full name for display -->
                <div class="form-group">
                  <label for="fullName">Full Name <small>(optional)</small></label>
                  <input type="text" id="fullName" name="fullName" placeholder="e.g., John Doe"
                    value="<%= formData?.fullName || '' %>">
                  <small>Displayed in reports and user lists.</small>
                </div>

                <!-- Auto-generated Employee ID -->
                <div class="form-group">
                  <label>Employee ID</label>
                  <input type="text" value="Auto-assigned (e.g., EMP-001)" disabled>
                  <small>System generates a unique sequential ID</small>
                </div>

                <!-- Role, password, confirm password fields stay the same... -->

                <div class="form-group">
                  <label for="role">Access Level</label>
                  <select id="role" name="role" required>
                    <option value="">Select Role</option>
                    <option value="registrar" <%=formData?.role==='registrar' ? 'selected' : '' %>>
                      Employee (Registrar)
                    </option>
                    <option value="askeri" <%=formData?.role==='askeri' ? 'selected' : '' %>>
                      Askari (Road Officer)
                    </option>
                    <option value="admin" <%=formData?.role==='admin' ? 'selected' : '' %>>
                      Admin
                    </option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="password">Create Password</label>
                  <input type="password" id="password" name="password" required placeholder="Minimum 8 characters">
                </div>

                <div class="form-group">
                  <label for="confirmPassword">Confirm Password</label>
                  <input type="password" id="confirmPassword" name="confirmPassword" required
                    placeholder="Repeat password">
                </div>

                <button type="submit" class="btn btn-primary" style="background-color: #2c3e50;">
                  Create Account
                </button>
              </form>
    </div>
  </main>
</body>

</html>