<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Vehicle Registry</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-primary { background: #2c3e50; color: white; }
    .btn-primary:hover { background: #1a252f; }
    .btn-danger { background: #e74c3c; color: white; }
    .alert { padding: 12px; margin: 16px 0; border-radius: 4px; }
    .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
    th { background: #f8f9fa; font-weight: 600; }
    .role-badge { padding: 4px 8px; border-radius: 12px; font-size: 0.85em; }
    .role-admin { background: #e3f2fd; color: #1976d2; }
    .role-registrar { background: #e8f5e9; color: #388e3c; }
    .role-askeri { background: #fff3e0; color: #f57c00; }
    .actions { display: flex; gap: 8px; }
  </style>
</head>
<body>
  <div class="container">
      <!-- Display Error Messages -->
        <% if (error_msg && error_msg.length> 0) { %>
            <div class="alert alert-danger">
                <%= error_msg %>
            </div>
            <% } %>

                <!-- Display Success Messages (e.g., after registration) -->
                <% if (success_msg && success_msg.length> 0) { %>
                    <div class="alert alert-success">
                        <%= success_msg %>
                    </div>
                    <% } %>
    <!-- Header -->
    <div class="admin-header">
      <h1><%= title %></h1>
      <div>
        <a href="/auth/register" class="btn btn-primary">+ Register New Staff</a>
        <a href="/logout" class="btn btn-danger">Logout</a>
      </div>
    </div>

    <!-- Flash Messages -->
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (errorFlash && errorFlash.length) { %>
      <div class="alert alert-error"><%= errorFlash %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
      <div class="card">
        <h3>Total Users</h3>
        <p style="font-size: 2em; font-weight: bold;"><%= users.length %></p>
      </div>
      <div class="card">
        <h3>Admins</h3>
        <p style="font-size: 2em; font-weight: bold;"><%= users.filter(u => u.role === 'admin').length %></p>
      </div>
      <div class="card">
        <h3>Registrars</h3>
        <p style="font-size: 2em; font-weight: bold;"><%= users.filter(u => u.role === 'registrar').length %></p>
      </div>
      <div class="card">
        <h3>Askari</h3>
        <p style="font-size: 2em; font-weight: bold;"><%= users.filter(u => u.role === 'askeri').length %></p>
      </div>
    </div>

    <!-- User Table -->
    <div class="card">
      <h2>System Users</h2>
      <% if (users.length === 0) { %>
        <p style="color: #666; font-style: italic;">No users registered yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Employee ID</th>
              <th>Name</th>
              <th>Role</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><strong><%= user.employeeId %></strong></td>
                <td><%= user.fullName %></td>
                <td>
                  <span class="role-badge role-<%= user.role %>">
                    <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
                  </span>
                </td>
                <td><%= user.isActive ? '✅ Active' : '❌ Inactive' %></td>
                <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                <td class="actions">
                  <a href="/admin/users/<%= user._id %>/edit" class="btn btn-primary" style="padding: 4px 8px; font-size: 0.9em;">Edit</a>
                  <form action="/admin/users/<%= user._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Deactivate this user?');">
                    <button type="submit" class="btn btn-danger" style="padding: 4px 8px; font-size: 0.9em;">Deactivate</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>